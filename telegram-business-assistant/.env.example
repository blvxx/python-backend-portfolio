# Required Telegram bot token. Create it with @BotFather; never commit the real value.
BOT_TOKEN=123456789:replace_with_real_token

# Runtime mode: polling (one replica) or webhook (can be horizontally scaled).
BOT_MODE=polling

# Shared database and FSM state for the Docker Compose deployment.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
DATABASE_URL=postgresql://assistant:change-me@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0
FSM_STATE_TTL_SECONDS=86400

# Required only when BOT_MODE=webhook. Use the public HTTPS load-balancer URL.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook

# Runtime health and Prometheus metrics server.
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Optional Telegram administrator settings.
ADMIN_CHAT_ID=
ADMIN_USER_ID=

# Optional local-only SQLite fallback when DATABASE_URL is empty.
DATABASE_PATH=data/leads.sqlite3
